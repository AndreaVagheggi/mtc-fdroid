{"repo": {"timestamp": 1790274836000, "version": 20002, "name": "MindTheClub", "icon": "icon.png", "address": "https://fdroid.mindtheclub.com/repo", "description": "Official repository of MindTheClub, the peer to peer messenger that keeps messages on the phones and needs no company server. This is the build for phones without Google services: it uses UnifiedPush for notifications."}, "requests": {"install": [], "uninstall": []}, "apps": [{"authorName": "MindTheClub", "categories": ["Internet", "Phone & SMS"], "suggestedVersionName": "Release 1.69x (mtcx)", "suggestedVersionCode": "1070", "description": "MindTheClub is a messenger that carries messages straight from one phone to the\nother. There is no company server storing your chats, and no phone number is\nneeded to sign up.\n\nThis build is made for phones without Google services. Notifications arrive\nthrough UnifiedPush, so a distributor such as ntfy has to be installed.\n\n* Text, photos, videos, files and voice calls, end to end encrypted\n* Groups, with messages relayed between members\n* Bluetooth as an alternative transport when there is no network\n* Encrypted backup that carries your identity to a new phone\n\nThe app is free to try for 30 days. After that it needs a subscription, bought\non the web and activated inside the app.", "issueTracker": "https://github.com/AndreaVagheggi/mindtheclub/issues", "license": "GPL-3.0-only", "name": "MindTheClub", "sourceCode": "https://github.com/AndreaVagheggi/mindtheclub", "summary": "Peer to peer messenger, no company server", "webSite": "https://www.mindtheclub.com", "added": 1790186741000, "packageName": "com.bolimot.mindtheclub.x", "lastUpdated": 1790274832000}], "packages": {"com.bolimot.mindtheclub.x": [{"added": 1790274832000, "apkName": "mtcx-1070-release.apk", "hash": "09d77dc7eb5e7a9246aeadacc75e0bad3e14feded68671abb2f069543b39cc42", "hashType": "sha256", "minSdkVersion": 26, "nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "packageName": "co