{"repo": {"icon": {"en-US": {"sha256": "6aa7dd002a671d7e26b9dbd3f587c10850adae8e480c7556a7c41dd8e265fb9e", "size": 136579}}, "timestamp": 1793541016000, "categories": {"mtc_fdroid": null, "Internet": {"name": {"en-US": "Internet"}}, "Phone & SMS": {"name": {"en-US": "Phone & SMS"}}}}, "packages": {"com.bolimot.mindtheclub.x": {"metadata": {"categories": ["Internet", "Phone & SMS"], "issueTracker": "https://github.com/AndreaVagheggi/mindtheclub/issues", "lastUpdated": 1793541005000, "license": "GPL-3.0-only", "sourceCode": "https://github.com/AndreaVagheggi/mindtheclub", "webSite": "https://www.mindtheclub.com", "authorName": "MindTheClub", "summary": {"en-US": "Peer to peer messenger, no company server"}, "description": {"en-US": "MindTheClub is a messenger that carries messages straight from one phone to the\nother. There is no company server storing your chats, and no phone number is\nneeded to sign up.\n\nThis build is made for phones without Google services. Notifications arrive\nthrough UnifiedPush, so a distributor such as ntfy has to be installed.\n\n* Text, photos, videos, files and voice calls, end to end encrypted\n* Groups, with messages relayed between members\n* Bluetooth as an alternative transport when there is no network\n* Encrypted backup that carries your identity to a new phone\n\nThe app is free to try for 30 days. After that it needs a subscription, bought\non the web and activated inside the app."}}, "versions": {"9587ac13b3a0263ca7f8a2c6dd2ca0776425bf9add43564842cad88c60996d7a": {"added": 1793541005000, "file": {"name": "/mtcx-1086-release.apk", "sha256": "9587ac13b3a0263ca7f8a2c6dd2ca0776425bf9add43564842cad88c60996d7a", "size": 98522194}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "Release 1.86 (mtcx)", "versionCode": 1086, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 36}, "signer": {"sha256": ["18383a9aa5a40de426bbad1528acea9b08c027b15a2ef459bf8840807f9ed10e"]}, "usesPermission": [{"nam